APP_NAME="Dot.Auction"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://auction.infodot.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# Generate a unique app id/key/secret per environment -- never reuse the
# same credentials across environments or across other Dot platforms:
#   php -r 'echo random_int(100000, 999999);'   # REVERB_APP_ID
#   php -r 'echo bin2hex(random_bytes(20));'     # REVERB_APP_KEY
#   php -r 'echo bin2hex(random_bytes(32));'     # REVERB_APP_SECRET
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Internal bind address/port for the reverb:start process itself, separate
# from the public REVERB_HOST/PORT/SCHEME above that browsers connect to
# through a reverse proxy in production. Unset in local dev (falls back to
# REVERB_HOST/PORT, fine with no proxy in front). See docs/DOT_REALTIME_STANDARD.md
# in the Dot.Mines repo (the ecosystem reference implementation) for why
# this split exists.
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ecosystem SSO: InfoDot proves handoff tokens (this app has its own database).
# INFODOT_SERVICE_SECRET must equal ECOSYSTEM_SECRET_<KEY> in InfoDot's .env, and
# INFODOT_PLATFORM_KEY must be this platform's key there. Leave the secret blank to
# accept only tokens found in this app's own database (shared-database behaviour).
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=auction
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# Email-worthy events via Dot.Notify (blank = nothing is sent). The secret is this app's
# NOTIFY_INGEST_SECRET_AUCTION value in Dot.Notify's .env. Needs a queue worker.
NOTIFY_INGEST_URL=
NOTIFY_INGEST_SECRET=
NOTIFY_PLATFORM_KEY=auction

# Paying for a won auction via Paystack. TEST MODE ONLY: leave these blank and nothing changes
# (sales stay "awaiting payment"). Use sk_test_ / pk_test_ keys from the Paystack dashboard's Test mode.
# An sk_live_ key is refused (never sent) unless PAYSTACK_ALLOW_LIVE=true is ALSO set on purpose.
# Webhook URL to enter in Paystack: {APP_URL}/webhooks/paystack. Needs the scheduler (cron) running.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_ALLOW_LIVE=false
PAYSTACK_ATTEMPT_TTL_MINUTES=30
# Hours a winner has to pay before the sale is marked overdue (nothing is relisted or cancelled automatically).
AUCTION_PAYMENT_WINDOW_HOURS=72
# Comma-separated emails that may open the read-only "Payment operations" page.
AUCTION_OPERATOR_EMAILS=
