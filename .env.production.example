APP_NAME="Dot.Auction"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://auction.infodot.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Database-backed queue -- deploy/queue-worker.service and
# .supervisord.conf already assume `queue:work database`. Broadcast jobs
# (BidPlaced, OutbidNotification) and the auction:settle-ended scheduled
# sweep both flow through this.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# Generate unique credentials for this environment -- never reuse
# local/staging values or another Dot platform's:
#   php -r 'echo random_int(100000, 999999);'   # REVERB_APP_ID
#   php -r 'echo bin2hex(random_bytes(20));'     # REVERB_APP_KEY
#   php -r 'echo bin2hex(random_bytes(32));'     # REVERB_APP_SECRET
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Public-facing values -- what browsers connect to (wss://auction.infodot.app),
# proxied by Nginx/Apache down to the internal process below. See the
# "WebSocket Reverse Proxy" section in README.md.
REVERB_HOST=auction.infodot.app
REVERB_PORT=443
REVERB_SCHEME=https

# Internal bind address/port for the `reverb:start` process itself (see
# deploy/reverb.service / deploy/reverb.supervisord.conf). Not
# internet-facing directly -- only the reverse proxy talks to this.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
